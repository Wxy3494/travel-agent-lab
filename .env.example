# demo: synthetic fixtures, no network/model calls. live: AutoGen + AMap.
TRAVEL_MODE=demo
DEEPSEEK_API_KEY=
AMAP_API_KEY=
MODEL_NAME=deepseek-flash
MODEL_BASE_URL=https://api.deepseek.com
TRAVEL_DB=data/runtime/trips.sqlite3
TRAVEL_TIMEOUT_SECONDS=300
TRAVEL_MAX_REPAIRS=2
TRAVEL_MAX_TOOL_CALLS=300
TRAVEL_MAX_MODEL_CALLS=30
# Optional local estimate only; leave blank if current unit prices are unverified.
MODEL_INPUT_PRICE_PER_MILLION=
MODEL_OUTPUT_PRICE_PER_MILLION=
TRAVEL_API_URL=http://127.0.0.1:8000
# Weather lookup reuses the AMap key by default. Custom adapters follow docs/WEATHER_AND_HOTELS.md.
WEATHER_PROVIDER=amap
WEATHER_API_URL=
WEATHER_API_KEY=
# Admission checks: official venue adapters by default; never uses AMap per-capita cost as ticket price.
# Optional read-only adapter contract: docs/ADMISSION_VERIFICATION.md. No new key needed for official mode.
VISIT_PROVIDER=official
VISIT_API_URL=
VISIT_API_KEY=
VISIT_MAX_CALLS=60
# Optional Meituan reference lookup. Run python -m scripts.setup_meituan to install its pinned CLI.
MEITUAN_TRAVEL_ENABLED=false
MEITUAN_HT_TOKEN=
MEITUAN_NODE_PATH=
MEITUAN_CLI_PATH=
MEITUAN_TIMEOUT_SECONDS=125
